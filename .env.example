# All values here are public and end up in the browser bundle. Never put a service-role key in a
# variable starting with VITE_: anything with that prefix is compiled into the client.
#
# Accounts are not built yet. These placeholders exist so the contract is visible.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-the-anon-key

# Must stay false. A minor account needs verifiable parental consent, and this project has no
# consent flow, so the flag defaults to false and is never enabled by the build.
VITE_MINOR_ACCOUNTS=false
