{
  "name": "gloss",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run content:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:build": "node scripts/build-content.mjs",
    "content:lint": "node scripts/lint-content.mjs",
    "content:check": "node scripts/build-content.mjs --check && node scripts/lint-content.mjs",
    "content:verify": "node scripts/verify-refs.mjs",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
